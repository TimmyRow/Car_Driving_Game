{
  "name": "velocity-coast",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "preview": "vite preview --host 0.0.0.0 --outDir dist/client",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "build:poki": "tsc --noEmit && vite build --mode poki --outDir dist-poki",
    "build:web": "tsc --noEmit && vite build --mode standalone --outDir dist-web"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "three": "^0.180.0",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2"
  }
}
